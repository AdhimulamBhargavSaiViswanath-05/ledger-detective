# Google Gemini API Key
# Get your key from: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-api-key-here

# OpenAI API Key (alternative to Gemini)
# Get your key from: https://platform.openai.com/api-keys  
# OPENAI_API_KEY=sk-your-api-key-here

# Use Mock LLM for development (no API key needed)
# Set to "true" to use mock LLM even when API keys are present
# Set to "false" or remove to use real LLM when keys are available
USE_MOCK_LLM=true
